BOT_TOKEN=your_token_here

# Data Provider Mode: fallback | egxapi | shadow (default)
# fallback = Yahoo Finance only
# egxapi   = EGXAPI only (requires EGXAPI_KEY)
# shadow   = Yahoo Finance primary + EGXAPI validation in background
DATA_PROVIDER=shadow

# EGXAPI Shadow Provider (market-data only, paper mode)
# Get your free key at https://egxapi.com/auth/#signup
EGXAPI_KEY=
EGXAPI_ENV=paper
