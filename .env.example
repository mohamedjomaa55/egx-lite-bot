# EGX Lite Market Radar — Environment Variables
# Copy this file to .env and fill in your values.

# Telegram Bot API token (required)
BOT_TOKEN=

# EGXAPI key (required for shadow/egxapi modes)
EGXAPI_KEY=

# EGXAPI environment: paper | production
EGXAPI_ENV=paper

# Data provider mode: shadow | egxapi | fallback
DATA_PROVIDER=shadow

# Admin API key for protected endpoints (e.g., POST /api/radar/refresh)
ADMIN_API_KEY=

# Rate limiting (requests per minute, 0 = unlimited)
RATE_LIMIT_TELEGRAM_RPM=0
RATE_LIMIT_API_RADAR_RPM=30
RATE_LIMIT_API_HISTORY_RPM=60
RATE_LIMIT_API_REFRESH_RPM=5

# Background scan interval in minutes (default: 30)
SCAN_INTERVAL_MINUTES=30

# Server fallback: allow Flask dev server when waitress unavailable
ALLOW_DEV_SERVER_FALLBACK=false
